{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MLZ hub",
  "description": "The platform's networks in one region, the hub first: hubs/<region>.yaml, or the chunks in hubs/<region>/.",
  "type": "object",
  "properties": {
    "platform_address_space": {
      "type": "string",
      "description": "The region's platform range, a /21: the hub (its first /22, its subnets carved from it), management's /24, identity's /24 and a spare /23. No landing zone gets an address in it.",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(/(0*([0-9]|[12][0-9]|3[0-2])|((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])))?$"
    },
    "landing_zone_ranges": {
      "description": "Where landing zone networks get their address ranges.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(/(0*([0-9]|[12][0-9]|3[0-2])|((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])))?$"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(/(0*([0-9]|[12][0-9]|3[0-2])|((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])))?$"
          },
          "minItems": 1
        }
      ]
    },
    "reserved": {
      "description": "Ranges never given to a landing zone: existing networks, on-premises sites, partner links.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(/(0*([0-9]|[12][0-9]|3[0-2])|((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])))?$"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(/(0*([0-9]|[12][0-9]|3[0-2])|((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])))?$"
          }
        }
      ]
    },
    "firewall": {
      "type": "string",
      "description": "The hub's Azure Firewall tier.",
      "enum": [
        "Standard",
        "Premium",
        "Basic"
      ],
      "default": "Standard"
    },
    "dns_resolver": {
      "description": "A DNS resolver for Private Link names, for landing zones and on-premises.",
      "type": "boolean",
      "default": true
    },
    "bastion": {
      "description": "Azure Bastion, for VMs in any landing zone.",
      "type": "boolean",
      "default": false
    },
    "identity": {
      "description": "Identity's network in this region, for domain controllers, in the identity subscription. Its range is held either way.",
      "type": "boolean",
      "default": false
    },
    "names": {
      "description": "A hub component's own name, instead of the customer's template's (docs/naming.md); a changed name replaces the component.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "resource_group",
          "virtual_network",
          "firewall",
          "firewall_policy",
          "firewall_public_ip",
          "firewall_management_public_ip",
          "firewall_route_table",
          "bastion",
          "bastion_public_ip",
          "dns_resolver",
          "dns_resolver_inbound_endpoint",
          "dns_resolver_outbound_endpoint"
        ]
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
