{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MLZ customer",
  "description": "Customer-wide settings for governance. Any setting in mlz-core's governance/defaults.yaml can be overridden here.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The customer's name, for people reading this file."
    },
    "root_id": {
      "type": "string",
      "description": "The prefix of every management group ID and many resource names: 2 to 16 lower-case letters, digits and hyphens.",
      "pattern": "^[a-z0-9][a-z0-9-]{0,14}[a-z0-9]$"
    },
    "root_display_name": {
      "type": "string",
      "description": "The top management group's display name."
    },
    "primary_region": {
      "type": "string",
      "description": "Where the platform's own resources go; one of allowed_regions.",
      "pattern": "^[a-z0-9]+$"
    },
    "security_contact": {
      "type": "string",
      "description": "Defender for Cloud's security alerts go to this email address.",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "parent_management_group_id": {
      "type": "string",
      "description": "An existing management group to build the tree below, instead of the tenant root."
    },
    "subscriptions": {
      "description": "The platform subscriptions, each moved into the management group of the same name. management and connectivity are required.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "management": {
          "type": "string",
          "description": "A subscription ID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "connectivity": {
          "type": "string",
          "description": "A subscription ID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "identity": {
          "type": "string",
          "description": "A subscription ID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "security": {
          "type": "string",
          "description": "A subscription ID.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      },
      "additionalProperties": false
    },
    "allowed_regions": {
      "description": "Regions resources and resource groups may be created in.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+$"
      },
      "minItems": 1
    },
    "management_groups": {
      "description": "The optional management groups: security under Platform, local under Landing Zones.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "security": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "local": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "description": "Tag policies. A key given here replaces the default's whole list.",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "required": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]{0,11}$"
          },
          "description": "Tags required on every resource group in the landing zones (deny)."
        },
        "inherited": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]{0,11}$"
          },
          "description": "Tags copied from the resource group to resources that lack them (modify)."
        },
        "exempt_resource_groups": {
          "description": "Resource groups Azure creates itself, where the required tags are not enforced. One * per pattern.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90,
            "pattern": "^[^*]*[*]?[^*]*$"
          }
        },
        "in_sandboxes": {
          "description": "Whether sandboxes must tag their resource groups too.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "policy_assignments_to_remove": {
      "description": "ALZ policy assignments to leave out, by archetype.",
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "enum": [
          "root",
          "platform",
          "management",
          "connectivity",
          "identity",
          "security",
          "landing_zones",
          "corp",
          "online",
          "local",
          "sandbox",
          "decommissioned"
        ]
      },
      "additionalProperties": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      }
    },
    "naming": {
      "description": "How mlz-core names what it creates (docs/naming.md).",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "org": {
          "type": "string",
          "description": "The customer's code in every name: 2 to 4 lower-case letters and digits (default: the root ID).",
          "pattern": "^[a-z0-9]{2,4}$"
        },
        "template": {
          "type": "string",
          "description": "How names are made (default: {type}-{org}-{app}-{purpose}-{env}-{region}-{nn}). Tokens in braces, dashes and lower-case text; an empty {purpose} drops out."
        },
        "templates": {
          "description": "A template for one type, for the 24-character ones (storage_account, key_vault).",
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "enum": [
              "application_gateway",
              "azure_firewall",
              "bastion_host",
              "budget",
              "data_collection_rule",
              "dns_resolver",
              "dns_resolver_inbound_endpoint",
              "dns_resolver_outbound_endpoint",
              "firewall_policy",
              "github_network_settings",
              "key_vault",
              "log_analytics_workspace",
              "network_interface",
              "network_security_group",
              "private_endpoint",
              "public_ip_address",
              "resource_group",
              "route_table",
              "storage_account",
              "user_assigned_identity",
              "virtual_network"
            ]
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "environments": {
          "description": "A landing zone file's name to its environment's short name, added to or replacing mlz-core's (dev: dv, test: te, uat: ut, sit: st, qa: qa, preprod: pp, sandbox: sb, dr: dr, prod: pd).",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9]{1,4}$"
          }
        },
        "regions": {
          "description": "An Azure region to its short name, replacing Microsoft's code; before the first deployment only.",
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "enum": [
              "australiacentral",
              "australiacentral2",
              "australiaeast",
              "australiasoutheast",
              "austriaeast",
              "belgiumcentral",
              "brazilsouth",
              "brazilsoutheast",
              "canadacentral",
              "canadaeast",
              "centralindia",
              "centralus",
              "centraluseuap",
              "chilecentral",
              "denmarkeast",
              "eastasia",
              "eastus",
              "eastus2",
              "eastus2euap",
              "eastus3",
              "francecentral",
              "francesouth",
              "germanynorth",
              "germanywestcentral",
              "indiasouthcentral",
              "indonesiacentral",
              "israelcentral",
              "israelnorthwest",
              "italynorth",
              "japaneast",
              "japanwest",
              "jioindiacentral",
              "jioindiawest",
              "koreacentral",
              "koreasouth",
              "malaysiasouth",
              "malaysiawest",
              "mexicocentral",
              "newzealandnorth",
              "northcentralus",
              "northeastus5",
              "northeurope",
              "norwayeast",
              "norwaywest",
              "polandcentral",
              "qatarcentral",
              "southafricanorth",
              "southafricawest",
              "southcentralus",
              "southcentralus2",
              "southeastasia",
              "southeastus",
              "southeastus3",
              "southeastus5",
              "southindia",
              "southwestus",
              "spaincentral",
              "swedencentral",
              "swedensouth",
              "switzerlandnorth",
              "switzerlandwest",
              "taiwannorth",
              "taiwannorthwest",
              "uaecentral",
              "uaenorth",
              "uksouth",
              "ukwest",
              "westcentralus",
              "westeurope",
              "westindia",
              "westus",
              "westus2",
              "westus3"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9]{2,5}$"
          }
        },
        "repository": {
          "type": "string",
          "description": "How a landing zone's workload repo is named (default: {app}-{env}), with long names: {app} the workload's folder, {env} the landing zone's file, {org} the customer's code. Both {app} and {env} are needed."
        },
        "platform": {
          "description": "A part of the platform to its short name in names, replacing mlz-core's (hub: hub, dns: dns, management: mgt, identity: idn, bootstrap: mlz). The platform's environment is prod.",
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "enum": [
              "hub",
              "dns",
              "management",
              "identity",
              "bootstrap"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9]{2,5}$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
