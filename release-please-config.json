{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "generic",
          "path": "starter/mlz-governance/.github/workflows/mlz.yml"
        },
        {
          "type": "generic",
          "path": "starter/mlz-platform/.github/workflows/mlz.yml"
        },
        {
          "type": "generic",
          "path": "starter/mlz-vending/.github/workflows/mlz.yml"
        },
        {
          "type": "generic",
          "path": "docs/pipelines.md"
        }
      ]
    }
  }
}
