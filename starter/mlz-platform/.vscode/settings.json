// Editor help for this repo's YAML: the schemas of the mlz-core release this repo runs, which Red Hat's
// YAML extension reads (extensions.json recommends it). The file belongs to mlz-core: an upgrade
// (python3 -m mlz upgrade) replaces it with the new release's version, so keep your own settings in your
// user settings.
{
  "yaml.schemas": {
    "https://raw.githubusercontent.com/fortytwoservices/mlz-core/v0.11.0/schemas/connectivity.schema.json": ["connectivity/*.yaml", "connectivity/*.yml", "connectivity/*/*.yaml", "connectivity/*/*.yml"], // x-release-please-version
    "https://raw.githubusercontent.com/fortytwoservices/mlz-core/v0.11.0/schemas/network.schema.json": ["management/**/*.yaml", "management/**/*.yml", "identity/**/*.yaml", "identity/**/*.yml"], // x-release-please-version
    "https://raw.githubusercontent.com/fortytwoservices/mlz-core/v0.11.0/schemas/firewall-rules.schema.json": ["firewall-rules/**/*.yaml", "firewall-rules/**/*.yml"] // x-release-please-version
  }
}
